profiles {

  docker {
    docker.enabled    = true
    docker.runOptions = '-v /nfs:/nfs -v /lustre:/lustre -v /tmp:/tmp -e NUMBA_DISABLE_JIT=1 -e NUMBA_CACHE_DIR=/tmp/numba_cache'

    process {
      container = 'haniffalab/webatlas-pipeline:0.5.3'

      withLabel: build_config {
        container = 'haniffalab/webatlas-pipeline-build-config:0.5.3'
      }

      beforeScript = """
        set -e
        # Set before any Python execution
        export NUMBA_DISABLE_JIT=1
        export NUMBA_CACHE_DIR=/tmp/numba_cache
        export PYTHONNOUSERSITE=1
        unset PYTHONPATH PYTHONHOME
        mkdir -p /tmp/numba_cache
        export PATH="${projectDir}/bin:\$PATH"
      """

      withName: 'Generate_image' {
        cpus   = 4
        memory = 100.GB
        time   = '12h'
      }
    }
  }

  singularity {
    singularity.enabled    = true
    singularity.autoMounts = true
    singularity.cacheDir   = '/nfs/cellgeni/singularity/images'
    // Use SINGULARITYENV_ prefix to ensure variables are set inside container
    singularity.runOptions = '--cleanenv --bind /nfs:/nfs --bind /lustre:/lustre --bind /tmp:/tmp'
    
    process {
      container = 'haniffalab/webatlas-pipeline:0.5.3'

      withLabel: build_config {
        container = 'haniffalab/webatlas-pipeline-build-config:0.5.3'
        memory = 10.GB
      }

      // Use containerOptions to pass environment variables that are set BEFORE container starts
      containerOptions = '--env NUMBA_DISABLE_JIT=1 --env NUMBA_CACHE_DIR=/tmp/numba_cache --env PYTHONNOUSERSITE=1'

      env {
        PYTHONNOUSERSITE     = '1'
        NUMBA_DISABLE_JIT    = '1'
        NUMBA_CACHE_DIR      = '/tmp/numba_cache'
        XDG_CACHE_HOME       = '/tmp'
        MPLBACKEND           = 'Agg'
        OMP_NUM_THREADS      = '2'
        OPENBLAS_NUM_THREADS = '2'
        MKL_NUM_THREADS      = '2'
      }

      beforeScript = """
        set -e
        unset PYTHONPATH PYTHONHOME
        mkdir -p /tmp/numba_cache
        export NUMBA_DISABLE_JIT=1
        export NUMBA_CACHE_DIR=/tmp/numba_cache
        export PYTHONNOUSERSITE=1
        export PATH="${projectDir}/bin:\$PATH"
        
        # Verify the environment
        echo "=== Environment Check ==="
        echo "NUMBA_DISABLE_JIT=\$NUMBA_DISABLE_JIT"
        echo "NUMBA_CACHE_DIR=\$NUMBA_CACHE_DIR"
        echo "PYTHONNOUSERSITE=\$PYTHONNOUSERSITE"
        python3 -c "import os; print('Python sees NUMBA_DISABLE_JIT:', os.environ.get('NUMBA_DISABLE_JIT'))"
      """

      withName: 'image_to_zarr' {
        cpus   = 4
        memory = 60.GB
        time   = '12h'
        clusterOptions = '-W 12:00'
      }

      withName: 'Generate_image' {
        cpus   = 4
        memory = 100.GB
        time   = '12h'
        clusterOptions = '-W 12:00'
      }

      withName: 'route_file' {
        cpus   = 4
        memory = 32.GB
        time   = '12h'
        clusterOptions = '-M 32000 -R "rusage[mem=32000]" -W 12:00'
      }
    }
  }

  sanger {
    singularity.enabled    = true
    singularity.autoMounts = true
    singularity.cacheDir   = '/nfs/cellgeni/singularity/images'
    singularity.runOptions = '--cleanenv --home /tmp --bind /nfs:/nfs --bind /lustre:/lustre --bind /tmp:/tmp'

    executor {
      name = 'lsf'
      perJobMemLimit = true
    }

    process {
      executor  = 'lsf'
      queue     = 'normal'
      container = 'haniffalab/webatlas-pipeline:0.5.3'

      withLabel: build_config {
        container = 'haniffalab/webatlas-pipeline-build-config:0.5.3'
        memory = 10.GB
      }

      containerOptions = '--env NUMBA_DISABLE_JIT=1 --env NUMBA_CACHE_DIR=/tmp/numba_cache --env PYTHONNOUSERSITE=1'

      env {
        PYTHONNOUSERSITE     = '1'
        NUMBA_DISABLE_JIT    = '1'
        NUMBA_CACHE_DIR      = '/tmp/numba_cache'
        XDG_CACHE_HOME       = '/tmp'
        MPLBACKEND           = 'Agg'
        OMP_NUM_THREADS      = '2'
        OPENBLAS_NUM_THREADS = '2'
        MKL_NUM_THREADS      = '2'
      }

      beforeScript = """
        set -e
        unset PYTHONPATH PYTHONHOME
        mkdir -p /tmp/numba_cache
        export NUMBA_DISABLE_JIT=1
        export NUMBA_CACHE_DIR=/tmp/numba_cache
        export PYTHONNOUSERSITE=1
        export PATH="${projectDir}/bin:\$PATH"
        
        echo "=== Environment Check ==="
        echo "NUMBA_DISABLE_JIT=\$NUMBA_DISABLE_JIT"
        python3 -c "import os; print('Python sees NUMBA_DISABLE_JIT:', os.environ.get('NUMBA_DISABLE_JIT'))"
      """

      withName: 'image_to_zarr' {
        cpus   = 4
        memory = 60.GB
        time   = '12h'
        clusterOptions = '-W 12:00'
      }

      withName: 'Generate_image' {
        cpus   = 4
        memory = 60.GB
        time   = '12h'
        clusterOptions = '-W 12:00'
      }

      withName: 'route_file' {
        cpus   = 4
        memory = 32.GB
        time   = '12h'
        clusterOptions = '-M 32000 -R "rusage[mem=32000]" -W 12:00'
      }
    }
  }
}