profiles {

  conda { 
    conda.enabled = true
    process {
      conda = "$projectDir/envs/environment.yaml"
      withLabel: build_config {
        conda = "$projectDir/envs/build_config/environment.yaml"
      }
    }
  }

  docker { 
    docker.enabled = true
    process {
      container = 'haniffalab/webatlas-pipeline:0.5.4'
      withLabel: build_config {
        container = 'haniffalab/webatlas-pipeline-build-config:0.5.4'
      }
      withName: Generate_image {
        env.NUMBA_CACHE_DIR = '/tmp/numba'
        env.XDG_CACHE_HOME  = '/tmp'
      }
    }
  }
  
  singularity { 
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.runOptions = '-v /nfs:/nfs -v /lustre:/lustre -v /tmp:/tmp'
    singularity.cacheDir   = '/nfs/cellgeni/singularity/images'
    process {
      container = 'haniffalab/webatlas-pipeline:0.5.3'
      withLabel: build_config {
        container = 'haniffalab/webatlas-pipeline-build-config:0.5.3'
      }
      withName: Generate_image {
        env.NUMBA_CACHE_DIR = '/tmp/numba'
        env.XDG_CACHE_HOME  = '/tmp'
      }
    }
  }

}
